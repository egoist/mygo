{
  "mobile": {
    "id": "push",
    "ios": {
      "sources": [
        "ios/*.swift"
      ],
      "class": "PushPlugin",
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification"
        ]
      },
      "entitlements": {
        "aps-environment": "development"
      }
    },
    "android": {
      "sources": [
        "android/*.kt"
      ],
      "class": "PushPlugin",
      "dependencies": [
        "com.google.firebase:firebase-messaging:24.1.2"
      ],
      "application": [
        "        <service android:name=\"dev.mygo.PushService\" android:exported=\"false\"><intent-filter><action android:name=\"com.google.firebase.MESSAGING_EVENT\" /></intent-filter></service>"
      ]
    }
  }
}
