// The window's edges glowing while the assistant works, as the SwiftUI
// recreation of Apple Intelligence's glow lights the screen's
// (jacobamobin/AppleIntelligenceGlowEffect): the window's outline stroked
// inside its edge with an angular gradient of six colors around its
// middle, whose stops move about, in four layers drawn one over another:
// a crisp line 6 DIPs wide, then lines 9, 11 and 15 wide blurred by 4, 12
// and 15. Measured against SwiftUI drawing it: the gradient blends in
// Oklab, a blur's standard deviation is 0.95 of its radius, and a blur
// mixes the colors along the edge too. Two departures: the gradient wraps
// around rather than show a seam where it starts, and as it starts, a
// wave of light runs in from the edges and fades.

// Stops are the gradient's stops in order: a color, in Oklab (rgb: L, a
// and b), and where it lies around the window from 0 to 1 (a), clockwise
// from the right. SwiftUI blends a gradient's colors in Oklab.
var Stops [6]vec4

// Strength is how much it shows, from 0 to 1.
var Strength float
// Burst is the seconds since it started.
var Burst float
// Corner is the window's corner radius, in DIPs.
var Corner float

// srgb returns the color of Oklab's lab in sRGB.
func srgb(lab vec3) vec3 {
	l := lab.x + 0.3963377774*lab.y + 0.2158037573*lab.z
	m := lab.x - 0.1055613458*lab.y - 0.0638541728*lab.z
	s := lab.x - 0.0894841775*lab.y - 1.2914855480*lab.z
	l, m, s = l*l*l, m*m*m, s*s*s
	c := vec3(
		4.0767416621*l-3.3077115913*m+0.2309699292*s,
		-1.2684380046*l+2.6097574011*m-0.3413193965*s,
		-0.0041960863*l-0.7034186147*m+1.7076147010*s)
	c = clamp(c, 0, 1)
	return mix(12.92*c, 1.055*pow(c, vec3(1/2.4))-0.055, step(vec3(0.0031308), c))
}

// gradient returns the gradient's color at t, around the window from 0 to
// 1: the colors between the stops blended in Oklab, and between the last
// and the first across the start, where SwiftUI's AngularGradient would
// show a seam.
func gradient(t float) vec3 {
	first, last := Stops[0], Stops[5]
	span := first.a + 1 - last.a
	if t < first.a {
		return srgb(mix(last.rgb, first.rgb, (t+1-last.a)/max(span, 0.0001)))
	}
	if t >= last.a {
		return srgb(mix(last.rgb, first.rgb, (t-last.a)/max(span, 0.0001)))
	}
	c := last.rgb
	for i := 1; i < 6; i++ {
		a, b := Stops[i-1], Stops[i]
		if t >= a.a && t < b.a {
			c = mix(a.rgb, b.rgb, (t-a.a)/max(b.a-a.a, 0.0001))
		}
	}
	return srgb(c)
}

func erf(x float) float {
	x2 := x * x
	return sign(x) * sqrt(1-exp(-x2*(1.2732395+0.147*x2)/(1+0.147*x2)))
}

// span returns how much of the span from a to b covers x once blurred,
// s being the blur's standard deviation times the square root of two.
func span(x, a, b, s float) float {
	return 0.5 * (erf((b-x)/s) - erf((a-x)/s))
}

// stroke returns how much of the outline of a box of size, stroked width
// DIPs wide inside its edge and blurred by radius as SwiftUI blurs (a
// Gaussian of that standard deviation), covers pos: the box blurred less
// the box inside the stroke blurred, a blur of boxes being one across
// times one down.
func stroke(pos, size vec2, width, radius float) float {
	s := radius * 0.95 * 1.4142136
	outer := span(pos.x, 0, size.x, s) * span(pos.y, 0, size.y, s)
	inner := span(pos.x, width, size.x-width, s) * span(pos.y, width, size.y-width, s)
	return max(outer-inner, 0)
}

// blurredGradient returns the gradient's color at p, at t around the
// window, blurred along the nearest edge by radius DIPs as a blur mixes
// the colors there: along an edge h DIPs from the middle, a DIP turns
// h/r² radians at r DIPs from it.
func blurredGradient(p, size vec2, t, radius float) vec3 {
	q := 0.5*size - abs(p)
	h := abs(p.x)
	if q.y < q.x {
		h = abs(p.y)
	}
	st := radius * 0.95 * h / (6.2831853 * max(dot(p, p), 1))
	c := gradient(t) * 0.4026
	c += (gradient(fract(t-st)) + gradient(fract(t+st))) * 0.2442
	c += (gradient(fract(t-2*st)) + gradient(fract(t+2*st))) * 0.0545
	return c
}

// over draws a layer of color c covering a over what is drawn (premultiplied).
func over(dst vec4, c vec3, a float) vec4 {
	return vec4(c*a, a) + dst*(1-a)
}

func Fragment(dst vec4, pos vec2) vec4 {
	size := rectSize()
	p := pos - 0.5*size
	sd := roundRect(p, 0.5*size, Corner)
	wave := 0.0
	if Burst < 3 {
		front := 320 * (1 - exp(-Burst*2.2))
		x := (inside(p, size) - front) / (26 + 80*Burst)
		wave = exp(-x*x) * exp(-Burst*1.7) * 0.45
	}
	if -sd > 80 && wave < 0.002 {
		return vec4(0)
	}
	t := fract(atan2(p.y, p.x) / 6.2831853)
	// The layers in SwiftUI's order: the crisp line, then the blurred
	// ones over it.
	out := vec4(0)
	px := pixelScale()
	out = over(out, gradient(t), clamp((6+sd)*px+0.5, 0, 1)*clamp(0.5-sd*px, 0, 1))
	out = over(out, blurredGradient(p, size, t, 4), stroke(pos, size, 9, 4))
	out = over(out, blurredGradient(p, size, t, 12), stroke(pos, size, 11, 12))
	out = over(out, blurredGradient(p, size, t, 15), stroke(pos, size, 15, 15))
	out = over(out, gradient(fract(t+0.4)), wave)
	return out * Strength
}
